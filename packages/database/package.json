{
  "name": "@nordicdrive/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./catalogue": {
      "types": "./dist/catalog/release.d.ts",
      "default": "./dist/catalog/release.js"
    },
    "./catalogue-plan": {
      "types": "./dist/catalog/release-plan.d.ts",
      "default": "./dist/catalog/release-plan.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "owner:setup": "tsx src/admin/setup-owner.ts",
    "build": "prisma generate && tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "catalog:check": "tsx src/catalog/import-official.ts",
    "catalog:import": "tsx src/catalog/import-official.ts --apply",
    "catalog:test": "tsx --test src/catalog/plan.test.ts src/catalog/release.test.ts",
    "catalog:release": "tsx src/catalog/publish-release.ts",
    "catalog:initialize-staging": "tsx src/catalog/initialize-staging.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1"
  },
  "devDependencies": {
    "@nordicdrive/eslint-config": "workspace:*",
    "@nordicdrive/tsconfig": "workspace:*",
    "@types/node": "^22.8.6",
    "eslint": "^9.13.0",
    "prisma": "^5.21.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
