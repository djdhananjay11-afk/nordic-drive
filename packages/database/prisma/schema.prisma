generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CarStatus {
  AVAILABLE
  UPCOMING
  DISCONTINUED
}

enum VariantStatus {
  AVAILABLE
  ORDER_OPEN
  WAITLIST
  SOLD_OUT
  DISCONTINUED
}

enum BodyType {
  SUV
  SEDAN
  CROSSOVER
  WAGON
  HATCHBACK
  COUPE
  VAN
}

enum Drivetrain {
  FWD
  RWD
  AWD
}

enum FeatureCategory {
  SAFETY
  COMFORT
  PERFORMANCE
  CHARGING
  INTERIOR
  EXTERIOR
  SOFTWARE
  WINTER
}

enum MediaType {
  IMAGE
  VIDEO
  MODEL_3D
  DOCUMENT
}

enum LaunchStatus {
  RUMORED
  CONFIRMED
  DELAYED
  LAUNCHED
  CANCELLED
}

enum DealerType {
  OFFICIAL
  USED_CAR
  SERVICE
  IMPORTER
}

enum ChargingPlugType {
  CCS
  TYPE_2
  CHADEMO
  NACS
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model RolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  roleId     String   @db.Uuid
  action     String
  subject    String
  conditions Json?
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roleId, action, subject])
  @@index([roleId])
  @@index([action, subject])
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  roleId           String?           @db.Uuid
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  locale           String            @default("nb-NO")
  role             Role?             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  accounts         Account[]
  sessions         Session[]
  reviews          Review[]
  articles         Article[]
  comparisons      Comparison[]
  savedComparisons SavedComparison[]
  wishlistItems    Wishlist[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([roleId])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  slug           String        @unique
  country        String?
  logoUrl        String?
  websiteUrl     String?
  description    String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  isActive       Boolean       @default(true)
  cars           Car[]
  launches       Launch[]
  media          Media[]
  dealers        DealerBrand[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([isActive, deletedAt])
  @@index([deletedAt])
}

model Car {
  id             String          @id @default(uuid()) @db.Uuid
  brandId        String          @db.Uuid
  name           String
  slug           String
  displayName    String?
  tagline        String?
  description    String?
  status         CarStatus       @default(AVAILABLE)
  bodyType       BodyType
  segment        String
  modelYear      Int?
  heroImageUrl   String?
  priceFromNok   Int?
  monthlyFromNok Int?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants       Variant[]
  specifications Specification[]
  features       CarFeature[]
  reviews        Review[]
  comparisons    Comparison[]
  media          Media[]
  launches       Launch[]
  wishlistItems  Wishlist[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([status, deletedAt])
  @@index([bodyType])
  @@index([segment])
  @@index([priceFromNok])
  @@index([deletedAt])
}

model Variant {
  id                    String              @id @default(uuid()) @db.Uuid
  carId                 String              @db.Uuid
  name                  String
  slug                  String
  status                VariantStatus       @default(AVAILABLE)
  drivetrain            Drivetrain
  priceNok              Int
  monthlyEstimateNok    Int?
  batteryCapacityKwh    Decimal             @db.Decimal(6, 2)
  rangeWltpKm           Int
  rangeWinterEstimateKm Int?
  powerHp               Int?
  torqueNm              Int?
  acceleration0To100    Decimal?            @db.Decimal(4, 2)
  topSpeedKmh           Int?
  chargingAcKw          Decimal?            @db.Decimal(5, 2)
  chargingDcKw          Decimal?            @db.Decimal(6, 2)
  charging10To80Minutes Int?
  heatPump              Boolean             @default(false)
  plugType              ChargingPlugType    @default(CCS)
  seats                 Int?
  towingCapacityKg      Int?
  car                   Car                 @relation(fields: [carId], references: [id], onDelete: Cascade)
  specification         Specification?
  evCharging            EVCharging?
  features              VariantFeature[]
  media                 Media[]
  reviews               Review[]
  comparisonItems       ComparisonVariant[]
  wishlistItems         Wishlist[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  @@unique([carId, slug])
  @@index([carId])
  @@index([status, deletedAt])
  @@index([priceNok])
  @@index([rangeWltpKm])
  @@index([rangeWinterEstimateKm])
  @@index([batteryCapacityKwh])
  @@index([deletedAt])
}

model Specification {
  id                   String    @id @default(uuid()) @db.Uuid
  carId                String?   @db.Uuid
  variantId            String?   @unique @db.Uuid
  lengthMm             Int?
  widthMm              Int?
  heightMm             Int?
  wheelbaseMm          Int?
  bootSpaceLiters      Int?
  frunkLiters          Int?
  seats                Int?
  weightKg             Int?
  towingCapacityKg     Int?
  groundClearanceMm    Int?
  warrantyYears        Int?
  batteryWarrantyKm    Int?
  batteryWarrantyYears Int?
  payload              Json?
  car                  Car?      @relation(fields: [carId], references: [id], onDelete: Cascade)
  variant              Variant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([carId])
  @@index([variantId])
  @@index([deletedAt])
}

model Feature {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  category    FeatureCategory
  description String?
  iconName    String?
  cars        CarFeature[]
  variants    VariantFeature[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([category])
  @@index([deletedAt])
}

model CarFeature {
  id            String  @id @default(uuid()) @db.Uuid
  carId         String  @db.Uuid
  featureId     String  @db.Uuid
  isHighlighted Boolean @default(false)
  sortOrder     Int     @default(0)
  car           Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  feature       Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([carId, featureId])
  @@index([carId, sortOrder])
  @@index([featureId])
}

model VariantFeature {
  id            String  @id @default(uuid()) @db.Uuid
  variantId     String  @db.Uuid
  featureId     String  @db.Uuid
  isHighlighted Boolean @default(false)
  sortOrder     Int     @default(0)
  variant       Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  feature       Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([variantId, featureId])
  @@index([variantId, sortOrder])
  @@index([featureId])
}

model Review {
  id             String        @id @default(uuid()) @db.Uuid
  carId          String        @db.Uuid
  variantId      String?       @db.Uuid
  authorId       String        @db.Uuid
  title          String
  slug           String
  summary        String?
  content        String
  rating         Decimal?      @db.Decimal(3, 1)
  pros           String[]
  cons           String[]
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  publishedAt    DateTime?
  car            Car           @relation(fields: [carId], references: [id], onDelete: Cascade)
  variant        Variant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  author         User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@unique([carId, slug])
  @@index([carId])
  @@index([variantId])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([deletedAt])
}

model Comparison {
  id             String              @id @default(uuid()) @db.Uuid
  createdById    String?             @db.Uuid
  carId          String?             @db.Uuid
  title          String
  slug           String?             @unique
  description    String?
  isTemplate     Boolean             @default(false)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  createdBy      User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  car            Car?                @relation(fields: [carId], references: [id], onDelete: SetNull)
  variants       ComparisonVariant[]
  savedBy        SavedComparison[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  @@index([createdById])
  @@index([carId])
  @@index([isTemplate, deletedAt])
  @@index([deletedAt])
}

model ComparisonVariant {
  id           String     @id @default(uuid()) @db.Uuid
  comparisonId String     @db.Uuid
  variantId    String     @db.Uuid
  position     Int        @default(0)
  notes        String?
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  variant      Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, variantId])
  @@index([comparisonId, position])
  @@index([variantId])
}

model SavedComparison {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  comparisonId String     @db.Uuid
  name         String?
  notes        String?
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([userId, comparisonId])
  @@index([userId])
  @@index([comparisonId])
  @@index([deletedAt])
}

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  brandId     String?   @db.Uuid
  carId       String?   @db.Uuid
  variantId   String?   @db.Uuid
  launchId    String?   @db.Uuid
  articleId   String?   @db.Uuid
  type        MediaType
  url         String
  title       String?
  altText     String?
  width       Int?
  height      Int?
  blurDataUrl String?
  sortOrder   Int       @default(0)
  isPrimary   Boolean   @default(false)
  brand       Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  car         Car?      @relation(fields: [carId], references: [id], onDelete: Cascade)
  variant     Variant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  launch      Launch?   @relation(fields: [launchId], references: [id], onDelete: Cascade)
  article     Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([brandId])
  @@index([carId, sortOrder])
  @@index([variantId, sortOrder])
  @@index([launchId])
  @@index([articleId])
  @@index([type])
  @@index([deletedAt])
}

model Launch {
  id                    String       @id @default(uuid()) @db.Uuid
  brandId               String       @db.Uuid
  carId                 String?      @db.Uuid
  modelName             String
  slug                  String
  expectedLaunchDate    DateTime?
  estimatedPriceFromNok Int?
  status                LaunchStatus @default(RUMORED)
  confidenceLevel       Int          @default(50)
  sourceNote            String?
  seoTitle              String?
  seoDescription        String?
  canonicalUrl          String?
  brand                 Brand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  car                   Car?         @relation(fields: [carId], references: [id], onDelete: SetNull)
  media                 Media[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([carId])
  @@index([status, expectedLaunchDate])
  @@index([deletedAt])
}

model Article {
  id             String        @id @default(uuid()) @db.Uuid
  authorId       String        @db.Uuid
  title          String
  slug           String        @unique
  excerpt        String?
  content        String
  category       String
  coverImageUrl  String?
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  publishedAt    DateTime?
  author         User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  media          Media[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([authorId])
  @@index([category])
  @@index([status, publishedAt])
  @@index([deletedAt])
}

model Dealer {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  slug       String        @unique
  type       DealerType
  orgNumber  String?
  email      String?
  phone      String?
  websiteUrl String?
  address    String?
  city       String?
  postalCode String?
  country    String        @default("NO")
  latitude   Decimal?      @db.Decimal(9, 6)
  longitude  Decimal?      @db.Decimal(9, 6)
  brands     DealerBrand[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@index([type])
  @@index([city])
  @@index([deletedAt])
}

model DealerBrand {
  id       String @id @default(uuid()) @db.Uuid
  dealerId String @db.Uuid
  brandId  String @db.Uuid
  dealer   Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([dealerId, brandId])
  @@index([dealerId])
  @@index([brandId])
}

model EVCharging {
  id                     String           @id @default(uuid()) @db.Uuid
  variantId              String           @unique @db.Uuid
  chargingAcKw           Decimal?         @db.Decimal(5, 2)
  chargingDcKw           Decimal?         @db.Decimal(6, 2)
  charging10To80Minutes  Int?
  plugType               ChargingPlugType @default(CCS)
  batteryPreconditioning Boolean          @default(false)
  vehicleToLoad          Boolean          @default(false)
  batteryChemistry       String?
  chargingCurveNote      String?
  variant                Variant          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  @@index([chargingDcKw])
  @@index([plugType])
  @@index([deletedAt])
}

model Wishlist {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  carId     String    @db.Uuid
  variantId String?   @db.Uuid
  notes     String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  car       Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  variant   Variant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, carId, variantId])
  @@index([userId])
  @@index([carId])
  @@index([variantId])
  @@index([deletedAt])
}
