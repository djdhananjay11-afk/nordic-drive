# Server-side only. Never commit packages/database/.env or paste secrets into chat.
# Copy the correct connection strings from YOUR Supabase project's Connect panel.
# DATABASE_URL is used by Prisma Client; DIRECT_URL is used for migrations.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require"
