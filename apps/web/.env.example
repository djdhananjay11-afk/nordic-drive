NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_R3F_VIEWER=false
# Full navigation is restored. Curated mode remains an explicit reviewed-only option.
NORDICDRIVE_RELEASE_MODE=full
# Use database for reviewed publications; snapshot is an explicit offline preview.
NORDICDRIVE_CATALOGUE_SOURCE=database
# Vercel already disables standalone output. Use false for local Windows builds.
NEXT_OUTPUT_STANDALONE=false
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
OWNER_EMAIL=dj.dhananjay20@gmail.com
# Owner password is hashed in PostgreSQL by `pnpm owner:setup`, never stored here.

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_CARS_INDEX_NAME=nordicdrive_cars

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LOG_LEVEL=info
NEXT_PUBLIC_SENTRY_DSN=
