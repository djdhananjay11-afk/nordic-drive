NODE_ENV=development

# Apps
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_R3F_VIEWER=false
API_PORT=4000

# Database
DATABASE_URL=postgresql://nordicdrive:nordicdrive@localhost:5432/nordicdrive?schema=public

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# JWT shared with NestJS for backend route validation
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=nordicdrive
JWT_AUDIENCE=nordicdrive-api

# AI provider placeholder
OPENAI_API_KEY=

# Storage placeholder
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Monitoring / logging
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Algolia search
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_CARS_INDEX_NAME=nordicdrive_cars
