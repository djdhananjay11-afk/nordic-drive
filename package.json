{
  "name": "nordicdrive",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade automotive comparison platform for Norway.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "db:generate": "pnpm --filter @nordicdrive/database prisma:generate",
    "db:migrate": "pnpm --filter @nordicdrive/database prisma:migrate",
    "db:deploy": "pnpm --filter @nordicdrive/database prisma:deploy",
    "db:seed": "pnpm --filter @nordicdrive/database seed",
    "db:studio": "pnpm --filter @nordicdrive/database prisma:studio",
    "catalog:check": "pnpm --filter @nordicdrive/database catalog:check",
    "catalog:release": "pnpm --filter @nordicdrive/database catalog:release",
    "catalog:test-http": "pnpm --filter @nordicdrive/database exec tsx --test src/catalog/web-smoke.test.ts",
    "catalog:import": "pnpm --filter @nordicdrive/database catalog:import",
    "catalog:test": "pnpm --filter @nordicdrive/database catalog:test",
    "catalog:test-web": "pnpm --filter @nordicdrive/database exec tsx --tsconfig ../../apps/web/tsconfig.json --test ../../apps/web/lib/seo.test.ts ../../apps/web/features/catalogue/route-policy.test.ts",
    "vercel-build": "pnpm db:generate && turbo build --filter=@nordicdrive/web..."
  },
  "devDependencies": {
    "@nordicdrive/eslint-config": "workspace:*",
    "@nordicdrive/tsconfig": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
