{
  "name": "nordicdrive",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade automotive comparison platform for Norway.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "db:generate": "pnpm --filter @nordicdrive/database prisma:generate",
    "db:migrate": "pnpm --filter @nordicdrive/database prisma:migrate",
    "db:studio": "pnpm --filter @nordicdrive/database prisma:studio"
  },
  "devDependencies": {
    "@nordicdrive/eslint-config": "workspace:*",
    "@nordicdrive/tsconfig": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
